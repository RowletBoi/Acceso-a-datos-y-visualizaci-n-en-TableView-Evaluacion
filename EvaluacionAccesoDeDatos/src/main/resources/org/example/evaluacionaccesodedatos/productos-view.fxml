<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="651.0" prefWidth="794.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.evaluacionaccesodedatos.controller.ProductoController">
   <children>
      <Label layoutX="308.0" layoutY="14.0" prefHeight="22.0" prefWidth="191.0" text="Registro de Productos">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <Label layoutX="119.0" layoutY="64.0" text="Codigo: " />
      <Label layoutX="118.0" layoutY="101.0" text="Nombre:" />
      <Label layoutX="118.0" layoutY="137.0" text="Categoria: " />
      <Label layoutX="433.0" layoutY="65.0" text="Precio:" />
      <Label layoutX="435.0" layoutY="101.0" text="Stock:" />
      <TextField fx:id="txtCodigo" layoutX="189.0" layoutY="60.0" prefHeight="26.0" prefWidth="211.0" promptText="Ej: P000, T000" />
      <TextField fx:id="txtNombre" layoutX="189.0" layoutY="97.0" prefHeight="26.0" prefWidth="211.0" promptText="Nombre del Producto" />
      <TextField fx:id="txtPrecio" layoutX="499.0" layoutY="60.0" promptText="0.00" />
      <TextField fx:id="txtStock" layoutX="499.0" layoutY="97.0" promptText="Stock del Producto" />
      <TableView fx:id="tblProuctos" layoutX="63.0" layoutY="300.0" prefHeight="332.0" prefWidth="650.0">
        <columns>
            <TableColumn fx:id="colId" prefWidth="36.0" text="Id" />
          <TableColumn fx:id="colCodigo" prefWidth="92.0" text="Codigo" />
          <TableColumn fx:id="colNombre" prefWidth="238.0" text="Nombre" />
            <TableColumn fx:id="colCategoria" prefWidth="117.5" text="Categoria" />
            <TableColumn fx:id="colPrecio" prefWidth="91.5" text="Precio" />
            <TableColumn fx:id="colStock" prefWidth="74.0" text="Stock" />
        </columns>
      </TableView>
      <Button fx:id="btnEliminar" layoutX="189.0" layoutY="180.0" mnemonicParsing="false" onAction="#eliminarProductos" text="Eliminar" />
      <Button fx:id="btnGuardar" layoutX="117.0" layoutY="179.0" mnemonicParsing="false" onAction="#guardarFormulario" text="Guardar" />
      <Button fx:id="btnActualizar" layoutX="261.0" layoutY="179.0" mnemonicParsing="false" onAction="#actualizarRegistro" text="Actualizar Registro" />
      <Button fx:id="btnLimpiar" layoutX="393.0" layoutY="179.0" mnemonicParsing="false" onAction="#limpiarFormulario" text="Limpiar Formulario" />
      <ComboBox fx:id="cmbFiltros" layoutX="388.0" layoutY="264.0" prefWidth="150.0" />
      <Label layoutX="388.0" layoutY="238.0" text="Filtros de Busqueda">
         <font>
            <Font name="System Bold" size="13.0" />
         </font></Label>
      <CheckBox fx:id="chkProductosExistentes" layoutX="548.0" layoutY="268.0" mnemonicParsing="false" onAction="#productosExistentes" text="Solo Productos Existentes" />
      <ComboBox fx:id="cmbCategoria" layoutX="190.0" layoutY="131.0" prefHeight="26.0" prefWidth="213.0" />
      <Button fx:id="btnFiltro" layoutX="295.0" layoutY="264.0" mnemonicParsing="false" onAction="#aplicarFiltro" text="Aplicar Filtro" />

   </children>
</AnchorPane>
