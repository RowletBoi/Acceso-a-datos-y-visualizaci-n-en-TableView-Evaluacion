<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="572.0" prefWidth="718.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.evaluacionaccesodedatos.controller.ProductoController">
   <children>
      <Label layoutX="262.0" layoutY="12.0" prefHeight="22.0" prefWidth="191.0" text="Registro de Productos">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <Label layoutX="72.0" layoutY="65.0" text="Codigo: " />
      <Label layoutX="71.0" layoutY="102.0" text="Nombre:" />
      <Label layoutX="71.0" layoutY="138.0" text="Categoria: " />
      <Label layoutX="386.0" layoutY="66.0" text="Precio:" />
      <Label layoutX="388.0" layoutY="102.0" text="Stock:" />
      <TextField fx:id="txtCodigo" layoutX="142.0" layoutY="61.0" prefHeight="26.0" prefWidth="211.0" promptText="Ej: P000, T000" />
      <TextField fx:id="txtNombre" layoutX="142.0" layoutY="98.0" prefHeight="26.0" prefWidth="211.0" promptText="Nombre del Producto" />
      <TextField fx:id="txtPrecio" layoutX="452.0" layoutY="61.0" promptText="0.00" />
      <TextField fx:id="txtStock" layoutX="452.0" layoutY="98.0" promptText="Stock del Producto" />
      <TableView fx:id="tblProuctos" layoutX="46.0" layoutY="302.0" prefHeight="253.0" prefWidth="651.0">
        <columns>
            <TableColumn fx:id="colId" prefWidth="36.0" text="Id" />
          <TableColumn fx:id="colCodigo" prefWidth="96.0" text="Codigo" />
          <TableColumn fx:id="colNombre" prefWidth="213.0" text="Nombre" />
            <TableColumn fx:id="colCategoria" prefWidth="141.5" text="Categoria" />
            <TableColumn fx:id="colPrecio" prefWidth="96.5" text="Precio" />
            <TableColumn fx:id="colStock" prefWidth="67.0" text="Stock" />
        </columns>
      </TableView>
      <Button fx:id="btnEliminar" layoutX="142.0" layoutY="181.0" mnemonicParsing="false" onAction="#eliminarProductos" text="Eliminar" />
      <Button fx:id="btnGuardar" layoutX="70.0" layoutY="180.0" mnemonicParsing="false" onAction="#guardarFormulario" text="Guardar" />
      <Button fx:id="btnActualizar" layoutX="214.0" layoutY="180.0" mnemonicParsing="false" onAction="#actualizarRegistro" text="Actualizar Registro" />
      <Button fx:id="btnLimpiar" layoutX="346.0" layoutY="180.0" mnemonicParsing="false" onAction="#limpiarFormulario" text="Limpiar Formulario" />
      <ComboBox fx:id="cmbFiltros" layoutX="344.0" layoutY="264.0" prefWidth="150.0" />
      <Label layoutX="343.0" layoutY="241.0" text="Filtros de Busqueda" />
      <CheckBox fx:id="chkProductosExistentes" layoutX="509.0" layoutY="267.0" mnemonicParsing="false" onAction="#productosExistentes" text="Solo Productos Existentes" />
      <ComboBox fx:id="cmbCategoria" layoutX="143.0" layoutY="132.0" prefHeight="26.0" prefWidth="213.0" />

   </children>
</AnchorPane>
